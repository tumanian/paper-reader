# Copy to .env.local and fill in your keys (never commit .env.local):
#   cp .env.local.example .env.local
#
# Same vars as Vercel → Project Settings → Environment Variables
# Or copy from Supabase Dashboard → Settings → API

# Required — chat, summaries, citation matching/preview
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — cloud sync (your Supabase project)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional — global daily request ceiling (cost circuit-breaker).
# Server-only SERVICE ROLE key (Settings → API → service_role). NEVER expose it
# to the browser. Requires supabase/api-usage-ceiling.sql. Omit to disable the
# ceiling (proxy fails open). Per-IP limiting is done at the edge — see
# docs/RATE_LIMITING.md.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# DAILY_REQUEST_LIMIT=2000

# Local server port (default 3000)
# PORT=3000
