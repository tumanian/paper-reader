# Copy to .env.local and fill in your keys (never commit .env.local):
#   cp .env.local.example .env.local
#
# Same vars as Vercel → Project Settings → Environment Variables
# Or copy from Supabase Dashboard → Settings → API

# Required — highlight chat
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — library summaries + citation matching/preview
GROQ_API_KEY=gsk_your-key-here

# Optional — cloud sync (your Supabase project)
SUPABASE_URL=https://pmyodrwlvbqbukirecjh.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# Local server port (default 3000)
# PORT=3000
